# Copy to .env for the local Docker environment. These are example dev values.
APP_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=bpm
POSTGRES_USER=bpm
POSTGRES_PASSWORD=root
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development HS256 placeholder. Replace with a private random key (at least 32 UTF-8 bytes).
JWT_SECRET_KEY=dev-only-bpm-jwt-secret-change-before-deploy-2026
JWT_ISSUER=https://bpm.local
JWT_AUDIENCE=bpm-api
JWT_ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=7d
# P5.7 controlled task attachments. Configure a private S3-compatible bucket.
# Empty credentials use the AWS default credential provider (e.g. an IAM role).
BPM_STORAGE_ENABLED=false
BPM_STORAGE_ENDPOINT=
BPM_STORAGE_BUCKET=bpm-files
BPM_STORAGE_REGION=us-east-1
BPM_STORAGE_ACCESS_KEY=
BPM_STORAGE_SECRET_KEY=
